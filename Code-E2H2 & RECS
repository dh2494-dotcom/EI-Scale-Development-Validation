                                    SCALEG==0 ~"1.Never"),
         Health_Outcome=case_when(
           COLDMA==1~"Yes",
           HOTMA==1~"Yes",
           TRUE~"No"),
         Powerout=case_when(POWEROUT==0 ~ "No",
                            POWEROUT==1 ~ "Yes"),
         Coping_dimension =case_when(
           ENERGYASST20==1 ~ "2.Insecure",
           SCALEB == 1 ~ "2.Insecure",
           NOACHELP == 1 ~ "2.Insecure",
           TRUE ~ "1.secure"),
         EI=case_when(EI_any_9==0 ~ "Secure",
                      EI_any_9==1 ~ "Insecure")) %>%
  mutate(Eco_dimension = case_when(
    (Notice_Disconnection%in%"0" & Disconnect%in%"No") ~"1.secure",
    (Notice_Disconnection%in%"1" & Disconnect%in%"Yes")~"3.Severe",
    TRUE~"2.Moderate"),
    Phy_dimension = case_when(
      (Physical_condition%in%"No" & Powerout%in%"No" & Extremely_Cold%in%"1.Never"
       & Extremely_Hot%in%"1.Never" & SCALEG%in%"0") ~"1.secure",
      (Physical_condition%in%"Yes" & Powerout%in%"Yes" & 
         (Extremely_Cold%in%"3.>3days"| Extremely_Hot%in%"3.>3days" | SCALEG%in%"1")) ~"3.Severe",
      TRUE~"2.Moderate"),
    EI_Overall = case_when(
      Eco_dimension%in%"1.secure"&Phy_dimension%in%"1.secure"&Coping_dimension%in%"1.secure"~"1.secure",
      Eco_dimension%in%"3.Severe"&Phy_dimension%in%"3.Severe"&Coping_dimension%in%"2.Insecure"~"4.Extremely",
      Eco_dimension%in%"3.Severe"|Phy_dimension%in%"3.Severe"|Coping_dimension%in%"2.Insecure"~"3.Severe",
      TRUE~"2.Moderate"
    )) %>%
  select(Dataset,ID,Weight,
         Notice_Disconnection,Disconnect,Physical_condition,Powerout,Extremely_Cold,Extremely_Hot,
         SCALEG,
         Eco_dimension,Phy_dimension,Coping_dimension,EI_Overall,Health_Outcome
         )

