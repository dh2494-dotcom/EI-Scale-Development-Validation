dt_recs_select = dt_recs %>%
  filter(Paid%in%"Yes") %>%
  mutate(Dataset="RECS",
         ID=DOEID,
         Weight=NWEIGHT,
         Notice_Disconnection = SCALEE,
         Disconnect=case_when(NOHEATEL==1 ~"Yes",
                              NOHEATNG==1 ~"Yes",
                              NOHEATBULK==1 ~"Yes",
                              NOACEL==1 ~"Yes",
                              TRUE ~"No"),
         Physical_condition = case_when(NOHEATBROKE==1 ~ "Yes",
                                        NOACBROKE==1 ~ "Yes",
                                        TRUE ~"No"),
         Extremely_Hot = case_when(NOHEATDAYS>3~"3.>3days",
                                   NOHEATDAYS>0~"2.1-3days",
                                   SCALEG==0 ~"1.Never"),
         Extremely_Cold = case_when(NOACDAYS>3~"3.>3days",
